```python
#!/usr/bin/env python3
"""
GMFLOW v2.0 — GM1.6 Final Canonical Engine with Entropy Bottleneck Analysis
Node #10878 · Louisville, KY · 2026-04-29

Implements Theorems T1–T6 + Entropy Bottleneck Hypothesis.
Shell-stratified statistics and bottleneck metrics included.
"""

import os
import json
import numpy as np
import pandas as pd

class GM1CanonicalEngine:
    """Final canonical engine with entropy bottleneck detection."""

    @staticmethod
    def kaprekar_map(b: int, d: int) -> np.ndarray:
        """Exact base-b Kaprekar map on full domain."""
        N = b ** d
        T = np.zeros(N, dtype=np.int64)
        for x in range(N):
            digits = []
            val = x
            for _ in range(d):
                digits.append(val % b)
                val //= b
            digits = digits[::-1]

            asc_val = sum(a * b**i for i, a in enumerate(reversed(sorted(digits))))
            desc_val = sum(a * b**i for i, a in enumerate(reversed(sorted(digits, reverse=True))))
            T[x] = (desc_val - asc_val) % N
        return T

    @staticmethod
    def exact_signature(labels: np.ndarray):
        """Theorem T2: Exact labeled fiber census."""
        unique, counts = np.unique(labels, return_counts=True)
        return tuple(sorted(zip(unique.astype(int), counts.astype(int))))

    @staticmethod
    def shannon_entropy(probs: np.ndarray) -> float:
        """Exact Shannon entropy."""
        return -np.sum(probs * np.log2(probs))

    def compute_filtration(self, T: np.ndarray):
        N = len(T)
        current = np.arange(N, dtype=np.int64)
        seen = set()

        K_list, H_list, R_list = [], [], []
        M_c_list, M_w_list = [], []

        for step in range(N + 1):
            sig = self.exact_signature(current)
            if sig in seen:
                n_s = step
                break
            seen.add(sig)

            unique, counts = np.unique(current, return_counts=True)
            K_n = len(unique)
            probs = counts.astype(float) / N
            H_n = self.shannon_entropy(probs)

            # Merge entropies (T5 & T6)
            child = unique
            parent = T[child]
            _, mult_c = np.unique(parent, return_counts=True)
            M_c = self.shannon_entropy(mult_c / len(mult_c)) if len(mult_c) > 1 else 0.0

            mass = counts.astype(float) / N
            parent_mass = {}
            for p, m in zip(parent, mass):
                parent_mass[p] = parent_mass.get(p, 0.0) + m
            masses = np.array(list(parent_mass.values()))
            M_w = self.shannon_entropy(masses / masses.sum()) if len(masses) > 1 else 0.0

            K_list.append(int(K_n))
            H_list.append(float(H_n))
            M_c_list.append(float(M_c))
            M_w_list.append(float(M_w))

            if step > 0:
                R_list.append(float(H_list[-2] - H_n))

            current = T[current]

        else:
            n_s = N

        # === ENTROPY BOTTLENECK METRICS ===
        R_array = np.array(R_list)
        bottleneck_local = np.zeros(len(R_array))
        if len(R_array) > 1:
            bottleneck_local[1:] = np.abs(R_array[1:] - R_array[:-1]) / (R_array[:-1] + 1e-12)

        bottleneck_strength = float(np.max(bottleneck_local)) if len(bottleneck_local) > 0 else 0.0
        bottleneck_step = int(np.argmax(bottleneck_local)) if len(bottleneck_local) > 0 else 0
        bottleneck_relative = float(bottleneck_step / n_s) if n_s > 0 else 0.0

        delta_H_bottleneck = float(H_list[bottleneck_step-1] - H_list[bottleneck_step+1]) \
            if 0 < bottleneck_step < len(H_list)-1 else 0.0

        return {
            'n_s': n_s,
            'K_n': K_list,
            'H_n': H_list,
            'R_n': R_list,
            'M_n_c': M_c_list,
            'M_n_w': M_w_list,
            'final_H': H_list[-1],
            # Bottleneck metrics
            'bottleneck_strength': bottleneck_strength,
            'bottleneck_step': bottleneck_step,
            'bottleneck_relative': bottleneck_relative,
            'delta_H_bottleneck': delta_H_bottleneck
        }

    def run_census(self, bases=range(2, 16), digits=[3, 4]):
        os.makedirs('../../results/gmflow_v2', exist_ok=True)
        results = []

        print("b\td\tN\tn_s\tH_final\tB_strength\tB_rel")
        print("-" * 65)

        for d in digits:
            for b in bases:
                T = self.kaprekar_map(b, d)
                obs = self.compute_filtration(T)

                print(f"{b:2d}\t{d}\t{b**d:6d}\t{obs['n_s']:3d}\t"
                      f"{obs['final_H']:.4f}\t{obs['bottleneck_strength']:.4f}\t{obs['bottleneck_relative']:.3f}")

                results.append({
                    'base': b,
                    'digits': d,
                    'N': b**d,
                    'n_s': obs['n_s'],
                    'K_n': json.dumps(obs['K_n']),
                    'H_n': json.dumps(obs['H_n']),
                    'R_n': json.dumps(obs['R_n']),
                    'M_n_c': json.dumps(obs['M_n_c']),
                    'M_n_w': json.dumps(obs['M_n_w']),
                    'final_H': obs['final_H'],
                    'bottleneck_strength': obs['bottleneck_strength'],
                    'bottleneck_relative': obs['bottleneck_relative'],
                    'delta_H_bottleneck': obs['delta_H_bottleneck']
                })

        df = pd.DataFrame(results)
        df.to_csv('../../results/gmflow_v2/gm1_6_census_with_bottlenecks.csv', index=False)
        print("\n✓ GM1.6 census with entropy bottleneck metrics completed.")
        return df


if __name__ == "__main__":
    engine = GM1CanonicalEngine()
    engine.run_census()
```

